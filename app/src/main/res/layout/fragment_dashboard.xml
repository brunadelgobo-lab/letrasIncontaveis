<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="150dp"
        tools:context=".ui.dashboard.DashboardFragment">


        <TextView
            android:id="@+id/text_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textAlignment="center"
            android:textSize="20sp"
            android:text="Cadastro de Livro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_item"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="Store Photo"
            android:scaleType="centerCrop"
            android:src="@android:drawable/gallery_thumb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_dashboard" />

        <Button
            android:id="@+id/button_select_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Selecionar Imagem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/image_item" />


        <EditText
            android:id="@+id/enderecoItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Livraria/Sebo"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/button_select_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/tituloItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Título"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/enderecoItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />


        <EditText
            android:id="@+id/descricaoItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Descrição"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/tituloItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />


        <EditText
            android:id="@+id/dataItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Data de Publicação"
            android:inputType="date"
            app:layout_constraintTop_toBottomOf="@id/descricaoItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />


        <EditText
            android:id="@+id/categoriaItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Gênero Literário"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/dataItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />


        <EditText
            android:id="@+id/quantidadeItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Quantidade"
            android:inputType="number"
            app:layout_constraintTop_toBottomOf="@id/categoriaItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/autorItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Autor(a)"
            android:inputType="text"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/quantidadeItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/editoraItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Editora"
            android:inputType="text"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/autorItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/precoItemEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Preço"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/editoraItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/salvarItemButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/precoItemEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>